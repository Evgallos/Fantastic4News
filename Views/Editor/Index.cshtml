@model IEnumerable<Fantastic4News.Models.Db.Article>

@{
	ViewData["Title"] = "Index";
}

<div class="my-5">
<h1>
	Articles for Approval
</h1>
</div>


<table class="table table-hover">
	<thead class="table-secondary py-2">
		>
		<tr>

			<th>

			</th>
			<th>
				@Html.DisplayNameFor(model => model.HeadLine)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.ContentSummary)
			</th>
			<th>
				Written By
			</th>

			<th></th>
			<th></th>
		</tr>
	</thead>
	<tbody class="table-group-divider">
		@foreach (var item in Model)
		{
			item.DateStamp = DateTime.Now;

			var name = item.User.FirstName + " " + item.User.LastName;
			<tr>
				<td>
					Article-@item.Id
				</td>
				<td>
					@item.HeadLine
				</td>
				<td>
					@item.ContentSummary
				</td>
				<td>
					@name
				</td>
				<td>
					<a asp-action="Details" asp-controller="Article" asp-route-id="@item.Id">Details</a>
				</td>
				<td>
					<div>
						<div class="dropdown">
							<button class="btn btn-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
								Action
							</button>
							<ul class="dropdown-menu">
								<li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#approveModal-@item.Id">Approve</a></li>
								<li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">Reject</a></li>
							</ul>

						</div>

						<!-- Approve Modal -->
						<div class="modal fade" id="approveModal-@item.Id" tabindex="-1" aria-labelledby="approveModalLabel-@item.Id" aria-hidden="true">
							<div class="modal-dialog modal-dialog-centered">
								<div class="modal-content">
									<div class="modal-header">
										<h5 class="modal-title" id="approveModalLabel-@item.Id">Set Publish Date</h5>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
									</div>
									<div class="modal-body">
										<form asp-action="ApproveArticle" method="post">
											<div>
												<h4>Article-@item.Id</h4>
											</div>
											<div class="mb-3">

												<input type="hidden" name="Id" value="@item.Id" />
												<label for="DateStamp" class="form-label">Publish Date</label>
												<input type="datetime" class="form-control" id="DateStamp" name="DateStamp" value="@item.DateStamp">
											</div>

											<div class="form-group">
												<label for="Priority">Priority</label>
												<select class="form-control" id="Priority" name="Priority" value="@item.Priority">
													<option value="3" >Low</option>
													<option value="2" >Medium</option>
													<option value="1">High</option>
												</select>
											</div>


											<div class="mb-3">
												<label class="form-check-label" for="EditorsChoice">
													Editor's Choice
												</label> &emsp;
												<input type="checkbox" class="form-check-input" value=true name="EditorsChoice">
											</div>


											<button type="submit" class="btn btn-primary">Submit</button>
										</form>
									</div>
								</div>
							</div>
						</div>

						<!-- Reject Modal -->
						<div class="modal fade" id="rejectModal-@item.Id" tabindex="-1" aria-labelledby="rejectModalLabel-@item.Id" aria-hidden="true">
							<div class="modal-dialog modal-dialog-centered">
								<div class="modal-content">
									<div class="modal-header">
										<h5 class="modal-title" id="rejectModalLabel-@item.Id">Reason for Rejection</h5>
										<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
									</div>
									<div class="modal-body">
										<form asp-action="RejectArticle" method="post">

											<div class="mb-3">
												<input type="hidden" name="Id" value="@item.Id" />
												<label for="rejectReason-@item.Id" class="form-label">Reason</label>
												<textarea class="form-control" id="rejectReason-@item.Id" name="rejectReason" rows="3"></textarea>
											</div>
											<button type="submit" class="btn btn-primary">Submit</button>
										</form>
									</div>
								</div>
							</div>
						</div>
					</div>
				</td>
			</tr>
		}
	</tbody>



</table>

