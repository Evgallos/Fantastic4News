@model IEnumerable<Fantastic4News.Models.Db.Article>

@{
	ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
	<a asp-action="Create">Create New</a>
</p>
<table class="table">
	<thead>
		<tr>

			<th>
				@Html.DisplayNameFor(model => model.HeadLine)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.ContentSummary)
			</th>
			<th>
				Written By
			</th>

			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			var name = item.User.FirstName + " " + item.User.LastName;
			<tr>

				<td>
					@item.HeadLine
				</td>
				<td>
					@item.ContentSummary
				</td>
				<td>
					@name
				</td>

				<td>
					<a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
					<a asp-action="Details" asp-controller="Article" asp-route-id="@item.Id">Details</a> |
					<a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>
