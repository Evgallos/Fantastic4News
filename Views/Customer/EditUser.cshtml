@model Fantastic4News.Models.Db.User

@{
    ViewData["Title"] = "Edit User";
}

<h1>EditUser</h1>

@Model.FirstName

	<div class="col-md-8">
		<form id="registerForm" asp-action="edit" asp-controller="customer" method="post">
			
			<div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
			<div class="form-floating mb-3">
				<input asp-for="FirstName" class="form-control" autocomplete="firstname" aria-required="true" placeholder="Énter your first name" />
				<label asp-for="FirstName">First Name</label>
				<span asp-validation-for="FirstName" class="text-danger"></span>
			</div>
			<div class="form-floating mb-3">
				<input asp-for="LastName" class="form-control" autocomplete="lastname" aria-required="true" placeholder="Énter your Last name" />
				<label asp-for="LastName">Lastname</label>
				<span asp-validation-for="LastName" class="text-danger"></span>
			</div>
			<div>
				<label asp-for="DOB">DateOfBirth</label>
				<input asp-for="DOB" class="form-control" autocomplete="lastname" aria-required="true" type="date" placeholder="DateOfBirth " />
				<span asp-validation-for="DOB" class="text-danger"></span>

			</div>
			<div class="form-floating mb-3">
				<input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
				<label asp-for="Email">Email</label>
				<span asp-validation-for="Email" class="text-danger"></span>
			</div>


			<div class="alert-primary">
			    <label>Password</label>
				<input type="password" placeholder="password" />
				<span class="text-danger"></span>
			</div>
		         <div class="alert-primary">
			<label>Confirm Password</label>
				<input type="password" placeholder="password" />
				<span  class="text-danger"></span>
			</div>
			<button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">update</button>
		</form>
	</div>


