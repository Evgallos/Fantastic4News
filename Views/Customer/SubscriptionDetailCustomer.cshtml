@model IEnumerable<Fantastic4News.Models.Db.Subscription>

@{
	ViewData["Title"] = "GetSubscriptionFor";
}

<h1>Subscription</h1>


<table class="table">
	<thead>
		<tr>

			<th>
				@Html.DisplayNameFor(model => model.SubscriptionType)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Created)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Expired)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Price) / Month
			</th>

			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@item.SubscriptionType.TypeName
				</td>
				<td>
					@item.Created
				</td>
				@{
					if (@item.SubscriptionType.TypeName.ToLower() == "free")
					{
						<td>
						-
						</td>
					}
					else
					{
						<td>
							@item.Expired
						</td>
					}
				}
					
					<td>
						@item.Price
					</td>
					<td>
						@item.User
					</td>

				</tr>
		}
	</tbody>
</table>
