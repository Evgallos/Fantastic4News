
@{
    ViewData["Title"] = "Confirmation";
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="container align-content-center align-items-center">
    <div class="w-100 align-items-center my-4 p-2">
        <div class="progress " role="progressbar" aria-label="Default striped example" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
            <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" style="width: 0%"></div>
        </div>
    </div>
    
    <div class="py-5 my-5 text-center">
        <div id="showMessageId" class="row bg-success-subtle text-center" style="display:none">
            <div class="col-md-10 py-3">Thank you. ***Enjoy reading!***</div>
        </div>
    </div>
</div>

<script>

        //show progress bar for 5 secs
    function moveProgressBar() {
        let progressBar = $("#progressBar");
        let showMsgDiv = $("#showMessageId");
        let width = 0;
        let interval = setInterval(function () {
            if (width >= 100) {
                clearInterval(interval);
                $("#showMessageId").show(); // Show the div after 5 seconds
            } else {
                width++;
                progressBar.css("width", width + '%');
                progressBar.attr("aria-valuenow", width);
            }
        }, 50); // 50ms interval for 5 seconds total (50ms * 100 = 5000ms = 5 seconds)
    }

    moveProgressBar();
</script>




