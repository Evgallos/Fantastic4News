@model Fantastic4News.ViewModels.ArticleIndexVM
@using Fantastic4News.Models.Db
@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";


    string categoryName = ViewBag.CategoryName;
}
@if (categoryName == null || categoryName == "")
{
    <h1>Articles (@Model.Articles.Count())</h1>
}
else
{
    <h1>Articles (@Model.Articles.Count())</h1>
    <h4>Category: @categoryName</h4>
}
@if (User.IsInRole("Journalist"))
{
<p>
    <a asp-action="Create">Create New</a>
</p>
}

<div class="m-4 p-3" style="border:1px dotted grey; border-radius:10px">
<div class="mb-2">Search article</div>

    <form asp-action="Index" asp-controller="Article">
        <input type="text" name="search" />

                 @*    @if ((User.IsInRole("Journalist") && (item.UserId == ViewBag.UserIdLoggedIn)) || (User.IsInRole("Admin")))
                    {
                        <span>
                            | <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                            <a asp-action = "Delete" asp-route-id = "@item.Id" > Delete </a >
                        </span>
                    } *@

        <button type="submit">Search</button>
        <button type="reset">Clear</button>
    </form>
</div>


<div>
    <partial name="_ArticleListPartial" model="@Model.Articles"/>
</div>