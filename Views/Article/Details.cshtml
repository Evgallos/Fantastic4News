@model Fantastic4News.Models.Db.Article

@{
    ViewData["Title"] = "Details";

    Layout = "~/Views/Shared/_CustomerLayout.cshtml";

}


<h1>Details</h1>

<div>
    <h4>Article</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DateStamp)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DateStamp)
        </dd>

        <dd class="col-sm-10">
            <img src="@Model.ImageLink" alt="@Model.LinkText"/>
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.HeadLine)
        </dt>
        <dd class="col-sm-10">
            <h3>@Model.HeadLine</h3>
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ContentSummary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ContentSummary)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Content)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Content)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Views)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Views)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Like)
        </dt>
        <dd class="col-sm-10">
            <span id="likes">@Html.DisplayFor(model => model.Like)</span>
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IsArhived)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IsArhived)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Category)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Category.Name)
        </dd>

    </dl>
</div>

<button onclick="likeArticle(@Model.Id)">Like</button>
@if (!User.IsInRole("Customer"))
{
    <div>
        <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a> | <a asp-action="Index">Back to List</a>
    </div>
}
else
{
    <div><a asp-action="Index" asp-controller="Customer">Goto Index page</a></div>
}