@model Fantastic4News.Models.Db.Article

@{
    ViewData["Title"] = "Details";



}

<div class="m-4 p-4" style="border:1px solid gray;  border-radius: 15px">
    <div class="row">
        <div class="col-4">
            <span><i>Article created at @Model.DateStamp by @Model.User.FirstName @Model.User.LastName</i></span>
        </div>
        <div class="col-4 text-center">
            Views: @Model.Views, Likes: @Model.Like
        </div>

        <div class="col-4 text-end">
            <a asp-action="Edit" asp-route-id="@Model?.Id">Edit</a>
        </div>
    </div>
    <h1>@Model.HeadLine</h1>
    <h4>Category: @Model.Category.Name</h4>
    <img src="@Model.ImageLink" class="mb-3" style="border:1px solid gray; border-radius:10px" alt="@Model.LinkText" />

    <p><b>@Model.ContentSummary</b></p>

    <p>@Model.Content</p>

    <button onclick="likeArticle(@Model.Id)">Like</button>

    <br /><br />
    <a class="mt-5" asp-action="Index">Back to List</a>

</div>