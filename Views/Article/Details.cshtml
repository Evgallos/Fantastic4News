
 @model Fantastic4News.Models.Db.Article

@using Fantastic4News.Models.Db
@using Microsoft.AspNetCore.Identity

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Details";
}

<div class="container align-content-lg-center p-4 shadow-lg rounded" style="border:1px solid #ddd;">
    <h1 style="text-shadow: 0px 0px 10px rgba(255, 255, 255, 0.1); text-align:center;">@Model.HeadLine</h1>
    <h4>Category: @Model.Category.Name</h4>
    <div class="row mb-4">
        <!-- Left Column: Large Image -Evangelos-->
        <div class="col-md-4">
            <img src="@Model.ImageLink" class="img-fluid shadow-sm rounded" alt="@Model.LinkText" />
        </div>

        <!-- Right Column: First Paragraph - Evangelos -->
        <div class="col-md-8">
            <p><b>@Model.ContentSummary</b></p>
            <p>@Model.Content</p>
        </div>
    </div>

    <div class="row mb-6">
        <!-- Left Column: Two Paragraphs -Evangelos-->
        <div class="col-md-9">
            <p>@Model.Content</p>
            <p>@Model.Content</p>
        </div>

        <!-- Right Column: Smaller Image - Evangelos-->
        <div class="col-md-3" style="text-transform:capitalize; text-align:center;">
            <h4>Official Sponsors</h4>
            <p><i>Online Game RPG Texter Commercial</i></p>
            <img src="~/css/images/81dh9heqnjl.png" class="img-fluid shadow-sm rounded shadow-btn" style="max-width: 80%;" alt="Official Sponsor Torn-City" />
            <p><strong><i>Create your character</i></strong></p>

            <!-- Button Linking to Torn City Comercial -Evangelos-->
            <div class="mt-0 text-center">
                <a href="https://www.torn.com/" target="_blank" class="btn btn-primary btn-sm shadow-sm">Visit Torn City</a>
            </div>
        </div>

    </div>
    <div class="row mb-6">

        <!-- Left Column: Two Paragraphs -Evangelos-->
        <div class="col-md-9">
            <p>@Model.Content</p>
            <p>@Model.Content</p>
        </div>
        <!-- Right Column: Smaller Image - Evangelos-->
        <div class="col-md-3" style="text-transform:capitalize; text-align:center;">
            <p><i>Online Game MMORPG Commercial</i></p>
            <img src="~/css/images/oip (2).jpg" class="img-fluid shadow-sm rounded shadow-btn" style="max-width: 80%;" alt="Official Sponsor Blizzard" />
            <p><strong><i>Register & Subscribe in Game</i></strong></p>

            <!-- Button Linking to Blizzard Comercial -Evangelos-->
            <div class="mt-0 text-center">
                <a href="https://www.blizzard.com/en-us/" target="_blank" class="btn btn-primary btn-sm shadow-sm" alt="Blizzard Entertainment Website Comercial">Visit Blizzard</a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-4">
            <span><i>Article created at @Model.DateStamp by @Model.User.FirstName @Model.User.LastName</i></span>
        </div>

        <div class="col-4 text-center">
            Views: @Model.Views
        </div>

        <div class="col-4 text-end">
            @if ((User.IsInRole("Journalist") && (@Model.UserId == ViewBag.UserIdLoggedIn)) || (User.IsInRole("Admin")))
            {
                <span>
                    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
                    <a asp-action="Delete" asp-route-id="@Model.Id"> Delete </a>
                </span>
            }
        </div>
    </div>

    @if (User.IsInRole("Customer"))
    {
        <div style="padding-left:20px;" >
            <button type="button" class="shadow-btn btn btn-sm btn btn-primary rounded btn" onclick="likeArticle(@Model.Id)">
                <i class="bi bi-hand-thumbs-up" style="font-size: 1rem;"></i>
            </button>
            <span id="likes">@Model.Like</span>
        </div>
    }

    <br />
    <a class="mt-5" asp-action="Index">Back to List</a>
</div>

