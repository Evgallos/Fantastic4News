@model Fantastic4News.ViewModels.ArticleIndexVM

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<h1>Create</h1>

<h4>Article</h4>
<hr />
<div class="row">

    <div class="col-md-4">
        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Article.UserId" />

            <div class="form-group mb-3">
                <select id="drpCategory" asp-for="Article.CategoryId" asp-items="@Model.CategoriesSelectList" onchange="showArticleForm()">
                    <option value="0" selected disabled>-- Select category --</option>
                </select>
            </div>

            <div id="createArticleForm" style="display:none">
                <div class="form-group mb-3">
                    <label asp-for="Article.LinkText" class="control-label"></label>
                    <input asp-for="Article.LinkText" class="form-control" />
                    <span asp-validation-for="Article.LinkText" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Article.HeadLine" class="control-label"></label>
                    <input asp-for="Article.HeadLine" class="form-control" />
                    <span asp-validation-for="Article.HeadLine" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Article.ContentSummary" class="control-label"></label>
                    <input asp-for="Article.ContentSummary" class="form-control" />
                    <span asp-validation-for="Article.ContentSummary" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Article.Content" class="control-label"></label>
                    <textarea asp-for="Article.Content" class="form-control" ></textarea>
                    <span asp-validation-for="Article.Content" class="text-danger"></span>
                </div>

                <script>
                    // Replace the <textarea> with CKEditor
                    CKEDITOR.replace('Article_Content');
                </script>

                <div class="form-group mb-3">
                    <label asp-for="Article.ImageFile" class="control-label"></label>
                    <input asp-for="Article.ImageFile" type="file" class="form-control" />
                    <span asp-validation-for="Article.ImageFile" class="text-danger"></span>
                </div>
                <br />
@*                 <div id="uploadedImg">here: <br /></div>
 *@

@*                 <div class="form-group mb-3">
                    <input asp-for="Article.ImageLink" class="form-control" id="uploadedImg" value=""  />
                    <span asp-validation-for="Article.ImageLink" class="text-danger"></span>
                </div> *@
          
               @*  <div class="form-group form-check mb-3">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="Article.IsArhived" /> @Html.DisplayNameFor(model => model.Article.IsArhived)
                    </label>
                </div>

                <div class="form-group form-check mb-3">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="Article.EditorsChoice" /> @Html.DisplayNameFor(model => model.Article.EditorsChoice)
                    </label>
                </div> *@


                <div class="form-group my-4">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </div>
        </form>
    </div>
</div>



<div class="my-3">
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}



