@using Microsoft.AspNetCore.Identity
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject SignInManager<User> SignInManager
@using Fantastic4News.Models.Db
@inject UserManager<User> UserManager



@{
	HttpContextAccessor.HttpContext.Session.SetString("UserRole", "Customer");
}



<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Fantastic4News</title>
	<link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

	@* <link rel="stylesheet" href="~/Fantastic4News.styles.css" asp-append-version="true" />
	<link rel="stylesheet" href="/styles.css"> *@
	<!-- Include CKEditor library -->
	<script src="https://cdn.ckeditor.com/4.16.2/standard/ckeditor.js"></script>

</head>

<body style="font-family: 'Times New Roman', serif;">
	<header>
		<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white mb-0 ">
			<div class="container-fluid">
				<a class="navbar-brand" href="#" style="font-size: 2rem; border: 2px solid #000; padding: 10px; box-shadow: 5px 5px 10px rgba(0,0,0,0.2);">
					Logo
				</a>
				<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
						aria-expanded="false" aria-label="Toggle navigation">
					<span class="navbar-toggler-icon"></span>
				</button>

				<div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
					<div class="col-1 border border-1 border-warning box-shadow" style="height:100px;position:center">
						<img class="img-fluid h-100 w-100" src="/css/Images/weather.JPG" alt="Alternate Text" />
					</div>
					<ul class="navbar-nav flex-grow-1">
						<li class="nav-item">
							<a class="nav-link text-dark" asp-area="" asp-controller="Customer" asp-action="Index">Home</a>
						</li>
						@if (SignInManager.IsSignedIn(User) && User.IsInRole("Customer"))
						{
							<li class="nav-item">
								<a class="nav-link text-dark" asp-area="" asp-controller="Customer" asp-action="SubscriptionType">Subscriptions</a>
							</li>
							<li class="nav-item">
								<a class="nav-link text-dark" asp-area="" asp-controller="Customer" asp-action="SubscriptionDetailCustomer">My Subscriptions</a>
							</li>

							<li class="nav-item">
								<a class="nav-link text-dark" asp-area="" asp-controller="Article" asp-action="index">Articles</a>
							</li>

						}
						@if (SignInManager.IsSignedIn(User) && User.IsInRole("Journalist"))
						{
							<li class="nav-item">
								<a class="nav-link text-dark" asp-area="" asp-controller="Article" asp-action="index">Articles</a>
							</li>
						}

						
						


					</ul>
					
						
					

					<partial name="_LoginPartial" />

				</div>

				


			</div>


		</nav>
		<div class="row  bg-white">


			@* <div class="col-1 border border-1 border-warning box-shadow" style="height:100px;">
				<img class="img-fluid h-100 w-100" src="/css/Images/weather.JPG" alt="Alternate Text" />
			</div> *@
			<div class="col-10">
				<nav class="border-bottom box-shadow mb-3 text-center  navbar-light ">
					@await Component.InvokeAsync("CategoryIndex")
				</nav>
			</div>
		</div>

	</header>
	<div class="container-fluid">
		<main role="main" class="pb-3">
			@RenderBody()
		</main>
	</div>

	<footer class="border-top footer text-muted">
		<div class="container-fluid">
			&copy; 2024 - Fantastic4News - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
		</div>
	</footer>
	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)

</body>
</html>

