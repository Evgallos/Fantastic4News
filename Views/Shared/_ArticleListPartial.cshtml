@model IEnumerable<Fantastic4News.Models.Db.Article>

@using Microsoft.AspNetCore.Identity
@using Fantastic4News.Models.Db

@inject UserManager<User> _userManager
@inject SignInManager<User> _signinManager

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    /*I used here so will be more easy to make changes instead looking all the CSS code, we can change the like as we want i use one simple Unicode hand
        -Evangelos
    */
    body {
        font-family: 'Times New Roman', Times, serif;
        background-color: #f4f4f9;
    }

    .content-wrapper {
        margin-top: 20px;
    }

    .article-image {
        width: 90%;
        height: auto;
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }

    .card {
        width: 100%;
        width: 900px; /* Larger width for cards - Evangelos */
        margin: 15px;
    }

    .second-image {
        width: 60%; /* Make second image smaller -Evangelos */
        margin: 0 auto; /* Center align the second image -Evangelos */
        padding-inline-end: 5px;
    }

    .card-body {
        padding: 20px;
    }

    .card-footer {
        padding: 10px;
    }

</style>

<div class="container content-wrapper">
    <div class="card-container">
        @foreach (var item in Model)
        {
            <div class="card article-card">
                <div class="row no-gutters">
                    <div class="col-md-6">
                        <img src="@item.ImageLink" alt="Article Image" class="article-image card-img">
                    </div>
                    <div class="col-md-6">
                        <div class="card-body">
                            <h5 class="card-title">@item.HeadLine</h5>
                            <p class="card-text"><strong>Category:</strong> @item.Category.Name</p>
                            <p class="card-text">@item.ContentSummary</p>
                            <p class="card-text">@Html.Raw(item.Content.Substring(0, item.Content.IndexOf("</p>", 0) + 4))</p>
                        </div>
                    </div>
                </div>

                <!-- Second Image and Additional Content -Evangelos -->
                <div class="row no-gutters">
                    <div class="col-md-6 order-md-2">
                        <img src="@item.ImageLink" alt="Second Article Image" class="second-image card-img">
                    </div>
                    <div class="col-md-6 order-md-1">
                        <div class="card-body">
                            <p>@Html.Raw(item.Content.Substring(item.Content.IndexOf("</p>", 0) + 4))</p>
                            <p>@Html.Raw(item.Content.Substring(item.Content.IndexOf("</p>", 0) + 4))</p>
                        </div>
                    </div>
                </div>
                <div class="card-footer mt-3 mb-0 align-content-md-center" style="box-shadow:10px;">
                    <button class="btn article-button btn-primary rounded align-content-center" style="box-shadow:5px;"alt="Button Like Article">👍</button>
                </div>

                <!-- Actions (Details, Edit, Delete) -Evangelos -->
                <div class="card-footer text-center">
                    @if (User.IsInRole("Journalist") || User.IsInRole("Editor") || User.IsInRole("Admin"))
                    {
                        <div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary effect-border">Details</a>
                            @if ((User.IsInRole("Journalist") && (item.UserId == ViewBag.UserIdLoggedIn)) || (User.IsInRole("Admin")))
                            {
                                <span>
                                    | <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning effect-border">Edit</a> |
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger effect-border">Delete</a>
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>

