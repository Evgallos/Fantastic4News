
@model IEnumerable<Fantastic4News.Models.Db.Article>

@using Microsoft.AspNetCore.Identity
@using Fantastic4News.Models.Db

@inject UserManager<User> _userManager
@inject SignInManager<User> _signinManager

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    /*List Article View CSS Bellow Keep this CSS code in here, if transfer it to CSS file then the home Page
    will effect also because i use the same names (card, container and etc i will update the names but for now keep it here.*/
    body {
        font-family: 'Times New Roman', Times, serif;
        background-color: #f4f4f9;
    }

    .content-wrapper {
        margin-top: 20px;
    }

    .article-image {
        width: 100%;
        height: auto;
        box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.1);
    }

    .card-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }

    .card {
        width: 100%;
        max-width: 900px; /* Card width - Larger than default -Evangelos*/
        margin: 15px 0;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        border: 2px white;
        border-radius: 10px;
    }

    .card-body {
        padding: 20px;
    }

    .card-footer {
        padding: 10px;
        text-align: right;
    }

    .card-title {
        font-size: 1.5rem;
        font-weight: bold;
    }

    .card-text {
        font-size: 1rem;
        color: #555;
    }

    .small-text {
        font-size: 0.85rem;
        color: #777;
    }

    .date-journalist {
        font-size: 0.85rem;
        color: #aaa;
    }

    .article-card {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.15);
    }

        .article-card img {
            max-width: 100%;
            border-radius: 8px;
        }

    .article-content {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding-left: 20px;
        padding-right: 20px;
    }

    .like-button {
        margin-top: 10px;
    }

    /* Responsive Design */

    .article-card {
        flex-direction: column;
        max-width: 767px;
    }

    .article-content {
        padding-left: 0;
        padding-right: 0;
        max-width: 767px;
    }
</style>

<div class="container content-wrapper">
    <div class="card-container">
        @foreach (var item in Model)
        {
            <div class="card article-card">
                <div class="row no-gutters">
                    <div class="col-md-4">
                        <img src="@item.ImageLink" alt="Article Image" class="article-image">
                    </div>
                    <div class="col-md-8">
                        <div class="article-content">
                            <h5 class="card-title">@item.HeadLine</h5>
                            <p class="card-text"><strong>Category:</strong><i>@item.Category.Name</i></p>
                            <p class="card-text">@item.ContentSummary</p>
                            <p class="card-text">@Html.Raw(item.Content.Substring(0, item.Content.IndexOf("</p>", 0) + 4)) </p>
                            <div>
                                <button class="btn btn-primary like-button" alt="Button Like Article">👍</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions (Details, Edit, Delete) -Evangelos -->
            <div class="card-footer text-center">
                @if (User.IsInRole("Journalist") || User.IsInRole("Editor") || User.IsInRole("Admin"))
                {
                    <div>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary effect-border">Details</a>
                        @if ((User.IsInRole("Journalist") && (item.UserId == ViewBag.UserIdLoggedIn)) || (User.IsInRole("Admin")))
                        {
                            <span>
                                | <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning effect-border">Edit</a> |
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger effect-border">Delete</a>
                            </span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>