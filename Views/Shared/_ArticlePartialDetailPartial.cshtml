<div class="card-container">
    <!-- Evangelos - Card Front -->
    <a asp-action="Details" asp-controller="Article" asp-route-id="@Model.Id" >
    <div class="card shadow-sm" data-id="@Model.Id" style="border: 2px solid #ddd;">
        <div class="card-face front">
            <img src="@Model.ImageLink" class="card-img-top img-fluid" alt="@Model.HeadLine" style=" height:250px"/>
            <div class="card-body">
                <!-- Evangelos - Card Title -->
                <h4 class="card-title m-1">
                   @Model.HeadLine
                </h4>
                <!-- Evangelos - Card Text -->
                <p class="card-text ms-2">
                    - @Model.User.FirstName @Model.User.LastName;
                </p>
                @* <button  type="button" class="speaker-icon" aria-label="Read this article aloud">
                    <i class="fa fa-volume-up"></i>
                </button> *@
            </div>
                @{
                    @if (User.IsInRole("Journalist") && (_userManager.GetUserId(User) == Model.UserId) || (User.IsInRole("Admin")))
                    {
                        <div class="card-footer">
                            <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
                            <a asp-action="Delete" asp-route-id="@Model.Id"> Delete </a>
                        </div>
                    }

                }
           
        </div>
   
