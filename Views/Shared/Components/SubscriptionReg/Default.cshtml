@model Fantastic4News.Models.ViewModels.SubscroptionChooseCustomer
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor


@* <partail name="_SubscriptionTypePartial" model="@Model"/>
 *@

@{
	string userId; int subtpid=0;
	if (HttpContextAccessor.HttpContext.Session.GetString("UserId") != null)
	{
		userId = HttpContextAccessor.HttpContext.Session.GetString("UserId");

	}
	HttpContextAccessor.HttpContext.Session.GetString("UserId");

	<div class="row mt-4">
		@foreach (var item in Model.SubsType)
		{
			<div class="col-sm-4  mt-5 py-2 ">
				<div  class="card glass2 py-2 mb-4" >
					<div class="card-body ">
                        <div class="ps-3 py-3 text-center bg-danger-subtle">
                            <h4 class="card-title">@item.TypeName</h4>
                        </div>

                        <div class="ps-3 my-2">
                            <p class="card-text ">
                                @item.Description <br />
                                @item.Price kr/month<br />
                            </p>
                        </div>
						@{
							if (@item.TypeName.ToLower() == "free")
							{
								<div class="btn-group btn-group-sm ps-3">
									<button type="button" onclick='chooseFreeSubscription(@item.Id)' class="btn btn-primary">Choose</button>
								</div>
							}
							else
							{
								<div class="btn-group btn-group-sm ps-3">
									<button type="button" onclick="chooseDateTimepartial(@item.Id ,'@item.TypeName',@item.Price)" class="btn btn-primary">Choose</button>
								</div>
								subtpid = item.Id;
							}
						}
					</div>
				</div>
			</div>
		}
	</diV>

	<div id="chooseDate" class="mt-3 glass2" style="display:none">
			<form asp-action="chooseOtherSubscription" asp-controller="Customer" method="post">

					<div class="row pb-3">
						<div id="subsTp" class="h4 text-info-emphasis"></div>
						<span id="errmsg" class="h5 text-danger"></span>
						<div class="form-group col-sm-8 pt-2 mb-2">
							<label asp-for="Subs.Created">From Date:</label>
							<input asp-for="Subs.Created" id="startDate" type="date" class="form-control" required />
							<span asp-validation-for="Subs.Created" class="text-danger"></span>
						</div>
						<div class="form-group col-sm-8 mt-2">
							<button class="btn btn-outline-primary text-warning-emphasis" type="button" onclick="ChooseSubs(1)"  >1 Month</button>
						
							<button class="btn btn-outline-primary text-warning-emphasis"type="button" onclick="ChooseSubs(3)">3 Month</button>

							<button class="btn btn-outline-primary text-warning-emphasis"type="button" onclick="ChooseSubs(12)" > 1 Year</button>

							<span id="errmsg"></span>						

						</div>

						<div class="form-group col-sm-8 pt-2">
							<label asp-for="Subs.Expired">To Date:</label>
							<input asp-for="Subs.Expired" id="ExpiresDate" type="date" class="form-control" value=""  />
							<span asp-validation-for="Subs.Expired" class="text-danger"></span>
						</div>
						<div class="col-sm-8 pt-2">
							<input asp-for="Subs.SubscriptionTypeId" id="forsubtyid" type="number" style="width:95%" value="" hidden />
						</div>
						<div class="col-sm-8 pt-2">
							<input asp-for="Subs.Price" id="forsubprice" type="number" style="width:95%" value="" hidden />
						</div>
						<div id="total" style="height:60px">
						
						</div>

						<div class="col-sm-4 mt-1">
							<button type="submit" class="btn btn-primary btn-block " id="submitbtn" disabled> Choose </button>
							<button type="button" class="btn btn-danger btn-block" onclick="cancelSubscription()"> Cancel </button>
						</div>

					

					</div>
			</form>
				<script src="~/lib/jquery/dist/jquery.min.js"></script> 
				<script src="~/js/Validation.js"></script>
	</div>
}
		


