@model IEnumerable<Fantastic4News.Models.ViewModels.LinkTextNewsVm>

<div class="modal fade sidebar-modal" id="linkTextModal" tabindex="-1" role="dialog" aria-labelledby="linkTextModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-right" role="document">
        
        <div class="modal-content bg">
                <a class="shadow-btn p-1" href="#" style="text-align:center; box-shadow: 2px 2px 2px rgba(0,0,0,0.2);">
                    <div class="wrapper bg-dark-subtle">
                        <div class="bg" style="font-size:32px;">
                            Fantastic 4
                        </div>
                        <div class="bg" style="font-size:32px;">
                            Fantastic 4
                        </div>
                    </div>
                </a>
            
            <div class="modal-header text-black">
                <h5 class="modal-title" id="linkTextModalLabel">
                    Link News
                </h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                @foreach (var item in Model)
                {
                    <div class="category-container mb-3">
                        
                        <div class="category-title mb-2 h4">
                            @item.CategoryName
                        </div>
                        <div class="category-links">
                            @foreach (var article in item.Articles)
                            {
                                <p class="mb-1"><a asp-action="Details" asp-controller="Article" asp-route-id="@article.Id">@article.LinkText</a></p>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer d-flex justify-content-between wrapper bg-dark-subtle">
                <div style="text-align:center;">
                    <div class="wrapper" style="font-size:22px; padding-left:90px;">
                        <div class="bg">
                            <i>News</i>
                        </div>
                        <div class="bg">
                            <i>News</i>
                        </div>
                    </div>
                </div>
                <button type="button" class="btn btn-secondary shadow-btn align-content-end" data-bs-dismiss="modal">
                    Close
                </button>
            </div>
        </div>
    </div>
</div>


