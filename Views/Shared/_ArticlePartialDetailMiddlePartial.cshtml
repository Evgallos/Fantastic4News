@model Fantastic4News.Models.Db.Article


<div class="card-container">
	<a asp-action="Details" asp-controller="Article" asp-route-id="@Model.Id">

		<!-- Evangelos - Card Front -->
		<div class="card shadow-sm" data-id="@Model.Id">
			<div class="card-face front">
				<img src="@Model.ImageLink" class="card-img-top img-fluid" alt="@Model.HeadLine" style="height:500px;" />
				<div class="card-body">
					<!-- Evangelos - Card Title -->
					<h4 class="card-title m-1">
						@Model.HeadLine
					</h4>
					<!-- Evangelos - Card Text -->
					<div class="card-text ms-3 py-3" style="height:76px">
						<p class="card-text ms-3 ">
							- @Model.User.FirstName @Model.User.LastName
							<br />
							@Model.ContentSummary
						</p>
					</div>

					@* <!-- Evangelos - Read Aloud Button -->
					<button class="speaker-icon" aria-label="Read this article aloud">
						<i class="fa fa-volume-up"></i>
					</button> *@
				</div>
			</div>
		</div>
	</a>
</div>