@using Microsoft.AspNetCore.Identity
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject SignInManager<User> SignInManager
@using Fantastic4News.Models.Db
@inject UserManager<User> UserManager



@{
    HttpContextAccessor.HttpContext.Session.SetString("UserRole", "Customer");
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fantastic4News</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script src="https://cdn.ckeditor.com/4.16.2/standard/ckeditor.js"></script>

</head>

<body style="font-family: 'Times New Roman', serif;">
    <partial name="_CookieConsentSimplyVersionPartial" />
    <header>
        <nav class="navbar-text text-light navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-black mb-0">
            <div class="container-fluid">
                <a class="navbar-brand" href="#" style="text-align:center; padding: 10px; box-shadow: 10px 10px 10px rgba(0,0,0,0.2);">
                   <div class="wrapper bg-dark-subtle">
                        <div class="bg">
                            Fantastic 4 <i>News</i>
                        </div>
                        <div class="bg">
                            Fantastic 4 <i>News</i>
                        </div>
                   </div>
                </a>


                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <div class="navbar-nav flex-grow-1 shadow">

                        <div class="animated-box" style="height:55px; width:220px; position:absolute; top:5px; left:65%; border-radius:10px; box-shadow:10px 10px 15px rgba(254,254,255,0.1);">
                            @await Component.InvokeAsync("Weather", new { city = "Linkoping" })
                        </div>

                        <div style="text-shadow: 20px; position:absolute; top:30%; left:45%; align-content:center;">
                            <form asp-action="Index" asp-controller="Article">
                                <div class="input-group shadow-btn align-content-center align-self-md-auto">

                                    <input type="search" name="search" class="form-control rounded" placeholder="Search" aria-label="Search" aria-describedby="search-addon" />
                                    <button type="submit" class="btn btn-outline-primary" data-mdb-ripple-init>Search Article</button>

                                </div>
                            </form>
                        </div>


                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>

                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">

                                @{
                                    if (SignInManager.IsSignedIn(User) && User.IsInRole("Customer"))
                                    {
                                        <partial name="_CustomerLayoutPartial" />
                                    }
                                    else if (SignInManager.IsSignedIn(User) && User.IsInRole("Journalist"))
                                    {
                                        <partial name="_JournalistLayoutPartial" />
                                    }

                                    else if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                                    {
                                        <partial name="_AdminLayoutPartial" />

                                    }
                                    else if (SignInManager.IsSignedIn(User) && User.IsInRole("Editor"))
                                    {
                                        <partial name="_EditorLayoutPartial" />
                                    }
                                    else
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link text-dark" asp-area="" asp-controller="Customer" asp-action="Index">Home</a>
                                        </li>
                                    }


                                }

                            </ul>


                            <partial name="_LoginPartial" />
                        </div>




                    </div>

                </div>
            </div>


        </nav>


        <div class="row  bg-white">
            <div class="col-10">
                <nav class="border-bottom box-shadow mb-3 text-center  navbar-light ">
                    @await Component.InvokeAsync("CategoryIndex")
                </nav>
            </div>
        </div>

    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container-fluid">
            &copy; 2024 - Fantastic4News - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

