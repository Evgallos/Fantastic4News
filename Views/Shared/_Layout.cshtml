@using Microsoft.AspNetCore.Identity
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject SignInManager<User> SignInManager
@using Fantastic4News.Models.Db
@inject UserManager<User> UserManager



@{
    HttpContextAccessor.HttpContext.Session.SetString("UserRole", "Customer");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fantastic4News</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script src="https://cdn.ckeditor.com/4.16.2/standard/ckeditor.js"></script>

</head>
<body style="font-family: 'Times New Roman', serif;">
    <partial name="_CookieConsentSimplyVersionPartial" />
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark text-light mb-0">
            <div class="container-fluid">
                <a class="navbar-brand" asp-action="index" asp-controller="customer" style="text-align:center; padding: 10px; box-shadow: 10px 10px 10px rgba(0,0,0,0.2);">
                    <div class="wrapper bg-dark-subtle">
                        <div class="bg">
                            Fantastic 4 <i>News</i>
                        </div>
                        <div class="bg">
                            Fantastic 4 <i>News</i>
                        </div>
                    </div>
                </a>

                <!-- Hamburger button for mobile devices -Evangelos-->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 text-wrap">
                        @{
                            if (SignInManager.IsSignedIn(User) && User.IsInRole("Customer"))
                            {
                                <partial name="_CustomerLayoutPartial" />
                            }
                            else if (SignInManager.IsSignedIn(User) && User.IsInRole("Journalist"))
                            {
                                <partial name="_JournalistLayoutPartial" />
                            }
                            else if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                            {
                                <partial name="_AdminLayoutPartial" />
                            }
                            else if (SignInManager.IsSignedIn(User) && User.IsInRole("Editor"))
                            {
                                <partial name="_EditorLayoutPartial" />
                            }
                            else
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-area="" asp-controller="Customer" asp-action="Index">Home</a>
                                </li>
                            }
                        }
                    </ul>
                    <!-- Right Navigation Items (Desktop Only) - Evangelos-->
                    <div class="d-none d-lg-flex align-items-center">
                        <div id="weatherInfo" class="me-3 m-auto">
                            @await Component.InvokeAsync("Weather", new { city = "Linkoping" })
                        </div>
                        <div class="me-3 m-auto">
                            @await Component.InvokeAsync("TodayBox")
                        </div>
                        <div class="ms-3">
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </div>
            </div>
        </nav>

        <!-- Mobile Content Inside Hamburger Menu - Evangelos-->
        <div class="collapse navbar-collapse bg-dark text-light" id="navbarContent" role="navigation" aria-labelledby="navbar-header">
            <h2 id="navbar-header" class="visually-hidden">Main Navigation Menu</h2>

            <div class="bg-dark text-light px-3 py-2 d-lg-none" role="region" aria-labelledby="login-section">
                <h3 id="login-section" class="visually-hidden">User Login Section</h3>
                <partial name="_LoginPartial" />
            </div>

            <div class="bg-dark text-light px-3 py-2 d-lg-none" role="complementary" aria-labelledby="weather-section">
                <div id="weather-section" class="w-75">
                    @await Component.InvokeAsync("Weather", new { city = "Linkoping" })
                </div>
                <div class="mt-2" aria-labelledby="today-box-section">
                    <span id="today-box-section" class="visually-hidden">Today's Highlights</span>
                    @await Component.InvokeAsync("TodayBox")
                </div>
            </div>
        </div>

        <div class="row w-100 bg-dark text-white">
            <div class="w-100">
                <nav class="row border-bottom box-shadow mb-3 text-center align-content-center m-auto">
                    <div class="col-md-8">
                        @await Component.InvokeAsync("CategoryIndex")
                    </div>

                    <div class="col-md-4 container" style="text-shadow: 20px;">
                        <form asp-action="Index" asp-controller="Article">
                            <div class="input-group shadow-btn m-auto form-check-inline my-2 my-lg-0" style="width:350px;">
                                <input type="search" name="search" class="form-control rounded" placeholder="Search" aria-label="Search" aria-describedby="search-addon" />
                                <button type="submit" class="btn btn-outline-primary ms-1 m-auto">Search Article</button>
                            </div>
                        </form>
                    </div>
                </nav>
            </div>
        </div>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Evangeloa, Scroll to Top Button -->
    <button id="scrollToTopBtn" onclick="scrollToTop()" class="button" aria-label="Scroll to Top">
        &#11161; <!-- Unicode -Evangelos-->
    </button>

    <footer class="border-top footer text-muted mb-0 m-auto">
        <div class="container-fluid text-center ">
            &copy; 2024 - <strong>Fantastic4</strong><i>News</i> - <a asp-area="" asp-controller="Home" asp-action="Privacy"><i>Privacy</i></a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>



