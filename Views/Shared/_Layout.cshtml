@using Microsoft.AspNetCore.Identity
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject SignInManager<User> SignInManager
@using Fantastic4News.Models.Db
@inject UserManager<User> UserManager



@{
    HttpContextAccessor.HttpContext.Session.SetString("UserRole", "Customer");
}



<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fantastic4News</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script src="https://cdn.ckeditor.com/4.16.2/standard/ckeditor.js"></script>

</head>
<body style="font-family: 'Times New Roman', serif;">

    <partial name="_CookieConsentSimplyVersionPartial" />
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-0">
            <div class="container-fluid">
                <a class="navbar-brand" href="#" style="text-align:center; padding: 10px; box-shadow: 10px 10px 10px rgba(0,0,0,0.2);">
                    <div class="wrapper bg-dark-subtle">
                        <div class="bg">
                            Fantastic 4 <i>News</i>
                        </div>
                        <div class="bg">
                            Fantastic 4 <i>News</i>
                        </div>
                    </div>
                </a>

                <!-- Hamburger button for mobile screens -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar content -->
                <div class="collapse navbar-collapse text-light" id="navbarNav">
                    <ul class="navbar-nav me-auto text-white">
                        @{
                            if (SignInManager.IsSignedIn(User) && User.IsInRole("Customer"))
                            {
                                <partial name="_CustomerLayoutPartial" />
                            }
                            else if (SignInManager.IsSignedIn(User) && User.IsInRole("Journalist"))
                            {
                                <partial name="_JournalistLayoutPartial" />
                            }
                            else if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                            {
                                <partial name="_AdminLayoutPartial" />
                            }
                            else if (SignInManager.IsSignedIn(User) && User.IsInRole("Editor"))
                            {
                                <partial name="_EditorLayoutPartial" />
                            }
                            else
                            {
                                <li class="nav-item text-white">
                                    <a class="nav-link text-light" asp-area="" asp-controller="Customer" asp-action="Index">Home</a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-none d-lg-flex align-items-center text-white col-auto">
                        <form asp-action="Index" asp-controller="Article" class="d-flex">
                            <input type="search" name="search" class="form-control rounded" placeholder="Search" aria-label="Search" />
                            <button type="submit" class="btn btn-outline-primary ms-2">Search</button>
                        </form>
                        <div class="me-3">
                            @await Component.InvokeAsync("Weather", new { city = "Linkoping" })
                        </div>
                        <div class="me-3">
                            @await Component.InvokeAsync("TodayBox")
                        </div>
                    </div>

                    <ul class="navbar-nav d-lg-none w-100 text-white">
                        <li class="nav-item">
                            <div class="px-3">
                                @await Component.InvokeAsync("Weather", new { city = "Linkoping" })
                            </div>
                        </li>
                        <li class="nav-item">
                            <div class="px-3">
                                @await Component.InvokeAsync("TodayBox")
                            </div>
                        </li>
                        <li class="nav-item">
                            <form asp-action="Index" asp-controller="Article" class="px-3 py-2">
                                <div class="input-group">
                                    <input type="search" name="search" class="form-control rounded" placeholder="Search" aria-label="Search" />
                                    <button type="submit" class="btn btn-outline-primary">Search</button>
                                </div>
                            </form>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto text-white">
                        <li class="nav-item text-white">
                            <partial name="_LoginPartial" />
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="row w-100 bg-dark text-white">
            <div class="col-12 text-center text-white">
                <nav class="border-bottom box-shadow mb-3">
                    @await Component.InvokeAsync("CategoryIndex")
                </nav>
            </div>
        </div>
    </header>

    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted mt-3">
        <div class="container-fluid text-center">
            &copy; 2024 - Fantastic4News - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

