<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Logo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Fantastic4News.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="styles.css">
</head>

<body style="font-family: 'Times New Roman', serif;">
    <header>
        <!-- Evangelos - Navigation bar with Logo on the left -->
        <nav class="navbar navbar-expand-lg navbar-light bg-light">
            <div class="container-fluid">
                <a class="navbar-brand" href="#" style="font-size: 2rem; border: 2px solid #000; padding: 10px; box-shadow: 5px 5px 10px rgba(0,0,0,0.2);">
                    Logo
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link active" href="#">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#">Contact</a>
                        </li>
                    </ul>
                </div>
            </div>

        </nav>

        <partial name="_CustomerLayoutPartial" />
        <partial name="_EmployeeLayoutPartial" />

    </header>

    @* <div class="container-fluid background">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div> *@

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <div class="container-fluid background">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

</body>
</html>
