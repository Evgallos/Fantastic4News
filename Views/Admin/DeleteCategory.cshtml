@model Fantastic4News.Models.Db.Category

@{
    ViewData["Title"] = "DeleteCategory";
}




<div class="d-flex justify-content-center align-items-center mt-5 mb-5">
    <div class="card border-3 border-danger h-100" style="border-radius:7px; width: 65rem;">
        <div class="card-header bg-dark text-white text-center">
            <h3 class="card-title">Delete Category</h3>
        </div>
        <div class="card-body bg-light text-center text-dark h-100 m-auto w-75 p-5">
            <h5>Are you sure you want to delete this Category?</h5>
            <div class="mt-3 d-flex justify-content-center">
                <h4>Category</h4>
                <hr />
                <div class="p-3 my-5">

                    <h5>
                    Name :   &emsp;       @Html.DisplayFor(model => model.Name)
                    </h5>
                    
                        
                                   

                </div>
            </div>
            <div class="alert alert-warning mt-3" role="alert">
                <strong>Warning:</strong> This action cannot be undone.
            </div>
            <form asp-action="DeleteCategoryconfirmed" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Delete" class="btn btn-danger" /> |
                <a asp-action="ViewCategories">Back to List</a>
            </form>
        </div>
    </div>
</div>