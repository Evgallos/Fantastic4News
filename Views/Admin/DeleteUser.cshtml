@model Fantastic4News.Models.Db.User

@{
    ViewData["Title"] = "DeleteUser";

}

<div class="d-flex justify-content-center align-items-center mt-5 mb-5">
    <div class="card border-3 border-danger h-100" style="border-radius:7px; width: 75rem;">
        <div class="card-header bg-dark text-white text-center">
            <h3 class="card-title">Delete Employee</h3>
        </div>
        <div class="card-body bg-light text-center text-dark h-100 w-75  m-auto p-5">
            <h5>Are you sure you want to delete this employee?</h5>
            <div class=" p-3 my-5 d-flex justify-content-center">
                <table>
                    <tr>
                        <td>Name:</td>
                        <td>@Model.FirstName @Model.LastName</td>
                    </tr>
                    <tr>
                        <td>Email:</td>
                        <td>@Model.Email</td>
                    </tr>
                </table>
            </div>
            <div class="alert alert-warning mt-3" role="alert">
                <strong>Warning..</strong>
            </div>
            <form asp-action="DeleteUserConfirmed" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger mr-2">Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>
