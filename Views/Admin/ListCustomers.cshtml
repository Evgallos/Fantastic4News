@model Fantastic4News.Models.ViewModels.CustomerInfoViewModel

@{
    ViewData["Title"] = "ListCustomers";
}

<h1>Customers</h1>


<div>
    <partial name="_ShowCharPartial" model="Model.Chart" />
</div>

<hr />

<p>
    <a asp-action="ListCustomer"></a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                FirstName
            </th>
            <th>
                LastName
            </th>
             <th>
                Email
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Customers)
        {
            <tr>
                <td>
                    @item.FirstName
                </td>
                <td>
                    @item.LastName
                </td>
                <td>
                    @item.EmailConfirmed
                </td>   
                
                <td>
                    <a asp-action="DetailsCustomer" asp-route-id="@item.Id">Details</a>

                </td>
            </tr>
        }
    </tbody>
</table>