@model Fantastic4News.Models.ViewModels.CustomerInfoViewModel

@{
    ViewData["Title"] = "ListCustomers";
}

<h1>Our Customers Information</h1>



<div class="my-3">
    <partial name="_ShowCharPartial" model="Model.Chart" />
</div>

<hr />

<div class="my-5">

<h3>
    Customers List
</h3>
</div>
<table class="table table-hover">
    <thead class="table-secondary py-2">
        <tr>
            <th>
                FirstName
            </th>
            <th>
                LastName
            </th>
             <th>

                Email

            </th>
            <th></th>
        </tr>
    </thead>
    <tbody class="table-group-divider">

        @foreach (var item in Model.Customers)

        {
            <tr>
                <td>
                    @item.FirstName
                </td>
                <td>
                    @item.LastName
                </td>
                <td>
                    @item.Email
                </td>   
                
                <td>
                  
                    <div>
                     
                        <a asp-action="DetailsCustomer" asp-route-id="@item.Id"> <button class=" btn btn-outline-info shadow-btn ">Details</button></a>
                    </div>
                   @*  <a asp-action="DetailsCustomer" asp-route-id="@item.Id"> <button type="submit">Details</button></a> *@
               
                </td>
            </tr>
        }
    </tbody>
</table>