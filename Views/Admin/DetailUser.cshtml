@model Fantastic4News.Models.ViewModels.EmployeeRegisterViewModel

@{
    ViewData["Title"] = "DetailsUser";

}

<div class="d-flex justify-content-center align-items-center mt-5 mb-5">
    <div class="card border-3 border-danger h-100" style="border-radius:7px; width: 60rem;">
        <div class="card-header bg-dark text-white text-center">
            <h3 class="card-title">Details Employee</h3>
        </div>
        <div class="card-body bg-light text-center text-dark text-w-100" style="width: 60rem;">
       @*  <div class="card-body bg-light text-center text-dark h-100 m-auto"> *@
           @*  <h5>Are you sure you want to delete this employee?</h5> *@
            <div class="mt-3 d-flex justify-content-center">
                <table>
                    <tr>
                        <td>Emp Id:</td>
                        <td>@Model.Id</td>
                    </tr>
                    <tr>
                        <td>First Name:</td>
                        <td>@Model.FirstName</td>
                    </tr>
                    <tr>
                        <td>Last Name:</td>
                        <td> @Model.LastName</td>
                    </tr>
                    <tr>
                        <td>DOB:</td>
                        @{
                            if (Model.Dob != null)
                            {
                                DateTime stringDate = (DateTime)@Model.Dob;
                                string? outputDate = stringDate.ToString("yyyy-MM-dd");

                                <td>@outputDate</td>
                            }

                        }

                        
                    </tr>
                    <tr>
                        <td>Role:</td>
                        <td>@Model.RoleName</td>
                    </tr>
                    <tr>
                        <td>Email:</td>
                        <td>@Model.Email</td>
                    </tr>

                </table>
            </div>
           @*  <div class="alert alert-warning mt-3" role="alert">
                <strong>Warning:</strong> This action cannot be undone.
            </div> *@
      
        </div>
    </div>
</div>