@model IEnumerable<Fantastic4News.Models.ViewModels.EmployeesWithRoleViewModel>
@{
	ViewData["Title"] = "Index";
}

<div class="my-5">

<a class="btn btn-outline-primary disabled-link" onclick="displayRegisterVC()">Register New Employee </a> 
</div>

<table class="table table-hover">
	<thead class="table-secondary py-2">
		<tr>

			<th>
				@Html.DisplayNameFor(model => model.EmployeeName)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Email)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Role)
			</th>


			<th></th>
		</tr>
	</thead>
	<tbody class="table-group-divider">
		@foreach (var item in Model)
		{
			<tr>
				<td>
					@item.EmployeeName
				</td>
				<td>
					@item.Email
				</td>
				<td>
					@item.Role
				</td>

				<td>
					<a class="btn btn-outline-primary shadow-btn" onclick="displayEditVC('@item.empId')" >Edit </a> |
					<a class="btn btn-outline-info shadow-btn " asp-action="DetailUser" asp-controller="admin" asp-route-id="@item.empId">Detail </a> |
					<a class="btn btn-outline-danger shadow-btn" asp-action="DeleteUser" asp-controller="admin" asp-route-id="@item.empId">Delete </a> 
				</td>

			</tr>
		}
	</tbody>
</table>

<div class="row contentcenter">
	<div class="col-md-8 glass2 " id="resultdiv" style="display:none">

	</div>
</div>